pipeline {
    agent any

    environment {
        VENV = "venv"
    }

    stages {

        stage('Setup Python Environment') {
            steps {
                sh '''
                python3 -m venv $VENV
                $VENV/bin/python -m pip install --upgrade pip
                $VENV/bin/python -m pip install -r messaging_app/requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                $VENV/bin/python -m pytest messaging_app --junitxml=test-results.xml
                '''
            }
        }
    }

    post {
        always {
            junit 'test-results.xml'
        }
    }
}